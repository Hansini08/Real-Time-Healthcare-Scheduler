# frontend/.gitignore
node_modules
dist
.env
.env.*
*.local

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories and files
.idea
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace

# Optional: Large files in public/ (images, etc.) that are managed elsewhere
# public/some-large-asset. Lfs

# Build output
/dist

# Optional specify :
# /dist/assets/js
# /dist/assets/css
# /dist/assets/img
# /dist/assets/fonts
# /dist/assets/i18n

# dotenv environment variables file
.env
.env.development
.env.test
.env.production
.env.local
.env.development.local
.env.test.local
.env.production.local